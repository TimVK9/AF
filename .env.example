# =========================================================
# DJANGO — ОСНОВНЫЕ НАСТРОЙКИ
# =========================================================

# Секретный ключ. Сгенерируйте свой:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string

# Режим отладки. На продакшене — False.
DJANGO_DEBUG=False

# Разрешённые хосты (через запятую)
DJANGO_ALLOWED_HOSTS=iskitim-afisha.ru,www.iskitim-afisha.ru,127.0.0.1,localhost

# Доверенные origin'ы для CSRF (через запятую)
DJANGO_CSRF_TRUSTED_ORIGINS=https://iskitim-afisha.ru,https://www.iskitim-afisha.ru


# =========================================================
# EMAIL (Яндекс.Почта)
# =========================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=hello@iskitim-afisha.ru
EMAIL_HOST_PASSWORD=your-yandex-app-password
DEFAULT_FROM_EMAIL=Афиша Искитим <hello@iskitim-afisha.ru>


# =========================================================
# ПРОЧЕЕ
# =========================================================
SUBSCRIBE_COOLDOWN_SECONDS=30

# Если перейдёте на PostgreSQL — раскомментируйте:
# DB_NAME=afisha
# DB_USER=afisha
# DB_PASSWORD=strong-password
# DB_HOST=127.0.0.1
# DB_PORT=5432